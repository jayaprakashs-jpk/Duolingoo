# Copy to .env and fill in. All optional: the APK works in Guest Mode without any of these.
# NOTE: EXPO_PUBLIC_* values are baked into the JS bundle. Never put a paid AI key you care about
# in a distributed APK. Use the Supabase Edge Function (supabase/functions/ai-tutor) instead.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_OPENAI_API_KEY=
EXPO_PUBLIC_OPENAI_MODEL=gpt-4o-mini
EXPO_PUBLIC_GEMINI_API_KEY=
EXPO_PUBLIC_GEMINI_MODEL=gemini-2.0-flash
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
