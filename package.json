{
  "name": "linguaspark",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && tsx scripts/check-no-style-functions.ts && tsx scripts/check-seed.ts && tsx scripts/check-grading.ts && tsx scripts/check-engines.ts && tsx scripts/check-import.ts && tsx scripts/check-db.ts && npm test",
    "seed:sql": "tsx scripts/export-seed.ts",
    "prebuild:android": "expo prebuild --platform android",
    "apk:debug": "expo prebuild --platform android && cd android && ./gradlew assembleDebug",
    "apk:release": "expo prebuild --platform android && cd android && ./gradlew assembleRelease",
    "ios": "expo run:ios",
    "test": "NODE_ENV=development jest"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@supabase/supabase-js": "^2.119.2",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.14",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-speech": "~14.0.8",
    "expo-speech-recognition": "^3.1.3",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "nativewind": "^4.2.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "^0.2.7",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.12",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.18",
    "react-test-renderer": "19.1.0",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "~5.9.2"
  },
  "private": true,
  "description": "LinguaSpark: offline-first language learning app (Expo, React Native, Supabase)"
}
